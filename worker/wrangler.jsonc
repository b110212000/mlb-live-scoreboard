{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mlb-score-notify",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "observability": {
    "enabled": true
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://b110212000.github.io",
    "VAPID_SUBJECT": "https://b110212000.github.io",
    "APP_URL": "https://b110212000.github.io/mlb-live-scoreboard/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_MONITOR",
        "class_name": "GameMonitor"
      },
      {
        "name": "PUSH_SERVICE",
        "class_name": "PushService"
      },
      {
        "name": "DEVICE_REGISTRY",
        "class_name": "DeviceRegistry"
      },
      {
        "name": "FEEDBACK_SERVICE",
        "class_name": "FeedbackService"
      }
    ]
  },
  "exports": {
    "GameMonitor": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PushService": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DeviceRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FeedbackService": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
